  "type": "module",
  "scripts": {
    "start:dev": "bun --bun next dev --experimental-https --experimental-https-key certificates/localhost-key.pem --experimental-https-cert certificates/localhost.pem --hostname 127.0.0.1 --port 8338",
    "start:prod": "NODE_ENV=production bun --bun run next-prod.ts",
    "build": "rm -rf .next && bun --bun next build",

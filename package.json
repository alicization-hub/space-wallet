    "@scure/bip39": "2.4.0",
    "@scure/btc-signer": "2.4.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "1.0.0-rc.5",
    "framer-motion": "^14.9.0",
    "next": "16.4.3",

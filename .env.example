# Environment variables specified in this way will always be included in the JavaScript bundle,
# prefixing the environment variable name with "NEXT_PUBLIC_" only has an effect when specifying them through the environment or .env files.
# https://nextjs.org/docs/basic-features/environment-variables

NEXT_TELEMETRY_DISABLED=1

NEXT_PUBLIC_APP_MODE=local
NEXT_PUBLIC_APP_NAME=project_name
NEXT_PUBLIC_APP_TZ=Asia/Singapore
# Only its port is used: `bun run start:prod` always listens on 127.0.0.1
NEXT_PUBLIC_BASE_URL=https://localhost:8338

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=dbname
# What the web server logs in as: it can't read the encrypted seeds.
DB_USER=web_space
DB_PASSWORD=
# The role that owns the tables, for scripts and backups. Its password is the terminal password, which is in no file.
DB_OWNER=username
DB_TZ=Asia/Singapore

# Bitcoin Core RPC
RPC_PROTOCOL=http
RPC_HOST=127.0.0.1
RPC_PORT=8332
# What the web server logs in as: read-only. Scripts that send use rpc_space_terminal, with the terminal password.
RPC_USERNAME=rpc_space
RPC_PASSWORD=

# Seed encryption. These aren't saved with the ciphertext: changing them makes existing wallets undecryptable.
# CIPHER_SECURITY is the log2 of the Argon2 memory in KiB (16 = 64 MiB).
CIPHER_SALT=16
CIPHER_KEY=32
CIPHER_NONCE=24
CIPHER_SECURITY=16
CIPHER_ARGON2_ITERATIONS=3
CIPHER_ARGON2_PARALLELISM=1
